# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=true
PERSIST_DATA=true
DATA_DIR=.data

# Phoenix / provider adapters
PHOENIX_API_URL=
PHOENIX_API_KEY=
PHOENIX_MODEL=phoenix-v1
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
