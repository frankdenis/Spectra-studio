# Browser-safe Supabase values (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_REDIRECT_URL=
VITE_ADMIN_EMAILS=
VITE_PHOENIX_MODEL=phoenix-v1

# Local API and WebSocket server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_DEV_AUTH=true
PERSIST_DATA=true
DATA_DIR=.data

# Supabase server values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI/media provider secrets — server-side only
PHOENIX_API_URL=
PHOENIX_API_KEY=
TAVUS_API_KEY=
PLAYHT_API_KEY=
PLAYHT_USER_ID=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
SPECTRA_MEDIA_VIDEO_URL=
SPECTRA_MEDIA_VIDEO_KEY=

# Realtime media
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
